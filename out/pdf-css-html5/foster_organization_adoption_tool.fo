                                    <fo:inline chfox:inch="true" height="390px" max-width="100%" width="301px"><fo:inline><fo:external-graphic src="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Images/IMG_0420.JPG" fox:alt-text="Cerberus Outside" max-width="100%" scaling="non-uniform" content-width="301px" content-height="390px"/></fo:inline></fo:inline>
