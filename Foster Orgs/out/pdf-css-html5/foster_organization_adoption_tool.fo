                                <fo:inline chfox:inch="true" height="300px" max-width="100%" id="unique_3_Connect_42_image_aqz_bxz_2gc" chfox:nd-id="image_aqz_bxz_2gc"><fo:inline><fo:external-graphic src="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./Images/IMG_0183.JPG" max-width="100%" scaling="uniform" height="300px" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                <fo:inline chfox:inch="true" height="310px" max-width="100%" width="355px" id="unique_3_Connect_42_image_p15_pms_4gc" chfox:nd-id="image_p15_pms_4gc"><fo:inline><fo:external-graphic src="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./Images/IMG_0305.JPG" max-width="100%" scaling="non-uniform" content-width="355px" content-height="310px"/></fo:inline></fo:inline>
