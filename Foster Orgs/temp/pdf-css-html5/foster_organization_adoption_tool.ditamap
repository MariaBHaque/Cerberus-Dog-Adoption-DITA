    <title class="- topic/title " xtrc="title:1;4:12" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap">Foster Organization Adoption Tool</title>
    <topicref class="- map/topicref " xtrc="topicref:1;5:69" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Concept-Cerberus-Profile%20foster%20orgs.dita" type="concept"><topicmeta class="- map/topicmeta " data-topic-id="cerberus-profile"><resourceid class="- topic/resourceid " oxy-source="topic" appid="cerberus-profile"/><navtitle class="- topic/navtitle ">Meet Cerberus: A Puppy with Big Drive!</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Meet Cerberus: A Puppy with Big Drive!</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">     Hi, I'm Cerberus! I'm an energetic and intelligent working dog breed looking for my forever home. Please read through this PDF guide to see if we're a good match!   </shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:2;6:69" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Concept-Cerberus-Match-Guide-foster-orgs.dita" type="concept"><topicmeta class="- map/topicmeta " data-topic-id="Cerberus-match-guide"><resourceid class="- topic/resourceid " oxy-source="topic" appid="Cerberus-match-guide"/><navtitle class="- topic/navtitle ">Cerberus Match Guide</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Cerberus Match Guide</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">This guide outlines Cerberus’s care needs, temperament, and compatibility to help determine if you and Cerberus are a good match.       A strong match ensures long-term success for both dog and caregiver.   </shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:3;7:64" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Reference-Daily-Routine-foster-orgs.dita" type="reference"><topicmeta class="- map/topicmeta " data-topic-id="Daily-Routine"><resourceid class="- topic/resourceid " oxy-source="topic" appid="Daily-Routine"/><navtitle class="- topic/navtitle ">Daily Routine: Feeding, Exercise, and Potty</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Daily Routine: Feeding, Exercise, and Potty</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">     Cerberus thrives with a consistent daily schedule to balance his energy, meet his core needs, and build trust.   </shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:4;8:79" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Reference-Common-Housing-Questions%20foster%20orgs.dita" type="reference"><topicmeta class="- map/topicmeta " data-topic-id="Common-Housing-Questions"><resourceid class="- topic/resourceid " oxy-source="topic" appid="Common-Housing-Questions"/><navtitle class="- topic/navtitle ">Common Housing Questions</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Common Housing Questions</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">     This reference answers the most common questions about preparing your home for Cerberus.    </shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:5;9:89" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Reference-Cerberus-Health-and-Vaccination-Record-foster-orgs.dita" type="reference"><topicmeta class="- map/topicmeta " data-topic-id="cerberus-health-record"><resourceid class="- topic/resourceid " oxy-source="topic" appid="cerberus-health-record"/><navtitle class="- topic/navtitle ">Cerberus Health and Vaccination Record</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Cerberus Health and Vaccination Record</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">This record shows Cerberus’s medical history, vaccination dates, and treatments for easy sharing with fosters, adopters, and vets.</shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:6;10:71" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="Reference-Foster-Contact-Sheet-foster-orgs.dita" type="reference"><topicmeta class="- map/topicmeta " data-topic-id="Volunteer-Foster-Contact-Sheet"><resourceid class="- topic/resourceid " oxy-source="topic" appid="Volunteer-Foster-Contact-Sheet"/><navtitle class="- topic/navtitle ">Volunteer and Foster Contact Sheet</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Volunteer and Foster Contact Sheet</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">     Internal reference for foster team and volunteers.      Lists key contacts, their roles, and the best way to reach them for Cerberus’s care and adoption needs.   </shortdesc></topicmeta></topicref>
    <topicref class="- map/topicref " xtrc="topicref:7;11:57" xtrf="file:/Users/mariahaque/Documents/Cerberus-Dog-Adoption-DITA/Foster%20Orgs./foster_organization_adoption_tool.ditamap" href="photo-repository-foster-orgs.dita" type="concept"><topicmeta class="- map/topicmeta " data-topic-id="photo-repository.dita"><resourceid class="- topic/resourceid " oxy-source="topic" appid="photo-repository.dita"/><navtitle class="- topic/navtitle ">Photo Repository</navtitle><?ditaot gentext?><linktext class="- map/linktext ">Photo Repository</linktext><?ditaot genshortdesc?><shortdesc class="- map/shortdesc ">This photo repository contains pictures of Cerberus with his foster family and friends. Photos are accompanied with a short description.</shortdesc></topicmeta></topicref>
